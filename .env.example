APP_ENV=native-dev
APP_NAME=The Company Agent
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=replace-with-a-random-local-secret
SESSION_COOKIE_NAME=company_agent_session
SESSION_IDLE_SECONDS=28800
SESSION_ABSOLUTE_SECONDS=604800

# Existing local MySQL. Do not commit real credentials.
MYSQL_URL=mysql+asyncmy://company_agent_app:change-me@127.0.0.1:3306/company_agent
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=5

# Existing local Redis.
REDIS_URL=redis://127.0.0.1:6379/3
REDIS_STREAM_NAME=company-agent-runs
REDIS_CONSUMER_GROUP=company-agent-workers

# Existing local Elasticsearch. Secure this instance before using real enterprise data.
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=company-agent-knowledge

# Native development storage. Keep outside source control.
LOCAL_STORAGE_ROOT=E:/Environment_f/company_agent_data/storage
LOCAL_STORAGE_MAX_BYTES=5368709120

# Agnes main Chat provider.
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash
AGNES_API_KEY=

# SiliconFlow Vision and Embedding providers.
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
SILICONFLOW_VISION_MODEL=Qwen/Qwen3.5-4B
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_EMBEDDING_DIMENSIONS=1024
ALLOW_EXTERNAL_CHAT=true
ALLOW_EXTERNAL_VISION=true
ALLOW_EXTERNAL_EMBEDDING=true

# Development CORS.
WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
